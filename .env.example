# This file documents every setting. On the server the installer
# (openrevise.com/install.php) writes the real .env for you.

APP_NAME=OpenRevise
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://openrevise.com
APP_TIMEZONE=Europe/London

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# The four sites. Subdomains default to app., api. and admin. of the main domain.
OPENREVISE_DOMAIN=openrevise.com
# OPENREVISE_APP_DOMAIN=app.openrevise.com
# OPENREVISE_API_DOMAIN=api.openrevise.com
# OPENREVISE_ADMIN_DOMAIN=admin.openrevise.com
OPENREVISE_SCHEME=https
OPENREVISE_PORT=

# Where diagrams are saved: the media folder inside the app subdomain folder.
# OPENREVISE_MEDIA_PATH=/home/xxxx/htdocs/app.openrevise.com/media

# Shown on the Privacy and Contact pages.
OPENREVISE_OWNER_NAME=
OPENREVISE_CONTACT_EMAIL=

# Three MySQL databases, each with its own user.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306

CONTENT_DB_HOST=localhost
CONTENT_DB_DATABASE=
CONTENT_DB_USERNAME=
CONTENT_DB_PASSWORD=

ADMIN_DB_HOST=localhost
ADMIN_DB_DATABASE=
ADMIN_DB_USERNAME=
ADMIN_DB_PASSWORD=

ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_DATABASE=
ANALYTICS_DB_USERNAME=
ANALYTICS_DB_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
