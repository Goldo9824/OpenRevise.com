# app.openrevise.com - the revision app moved to openrevise.com. This folder
# only sends old links there, to the same address, with a permanent redirect.
# Apache answers on its own: no PHP, so nothing here can loop.

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # This folder also sits inside the main site's folder; only answer on
    # the subdomain itself, never at openrevise.com/app.openrevise.com/.
    RewriteCond %{HTTP_HOST} !^app\. [NC]
    RewriteRule ^ - [R=404,L]

    # SSL certificate checks are answered here, never redirected.
    RewriteRule ^\.well-known/ - [L]

    # app.openrevise.com/gcse/biology/ -> https://openrevise.com/gcse/biology/
    RewriteCond %{HTTP_HOST} ^app\.([^:]+) [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>
