# Uploaded diagrams. Only images are served, never scripts.
#
# Only directives LWS allows in .htaccess: it refuses "Options ExecCGI"
# (and with it every file in this folder, as a 500). Scripts cannot run
# here because no file whose name has a script extension anywhere in it
# (x.php, x.php.png, x.phtml...) can be requested at all.

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<FilesMatch "\.(php\d*|pht|phtml|phar|pl|py|cgi|sh|s?html?)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=2592000"
    # SVG diagrams can hold scripts; this stops them running if opened directly.
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
