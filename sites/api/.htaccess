# api.openrevise.com - served from its own folder in the hosting space.

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # LWS maps the subdomain onto this folder inside the hosting root, so
    # without a base the rewrite to index.php below becomes
    # /api.openrevise.com/index.php, which Apache maps into this folder again,
    # and loops: a 500 on every page but the home page.
    RewriteBase /

    # This folder also sits inside the main site's folder; only answer on
    # the subdomain itself, never at openrevise.com/api.openrevise.com/.
    RewriteCond %{HTTP_HOST} !^api\. [NC]
    RewriteRule ^ - [R=404,L]

    # Force HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Hidden files are never served.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send requests to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
